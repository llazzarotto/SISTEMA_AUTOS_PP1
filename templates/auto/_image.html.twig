{% macro principal(auto, claseImagen, clasePlaceholder, basePath) %}
    {% set rutas = auto.obtenerRutasImagenes() %}
    {% set primeraRuta = rutas|first %}
    {% if primeraRuta %}
        {% set url = primeraRuta starts with 'http'
            ? primeraRuta
            : basePath ~ '/' ~ primeraRuta|trim('/') %}
        <img{% if claseImagen %} class="{{ claseImagen }}"{% endif %}
             src="{{ url }}"
             alt="{{ auto.modelo.marca.nombre }} {{ auto.modelo.nombre }}">
    {% else %}
        <div class="{{ clasePlaceholder }}" aria-hidden="true">🚗</div>
    {% endif %}
{% endmacro %}
