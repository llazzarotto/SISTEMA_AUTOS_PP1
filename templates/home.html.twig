{% extends "base.html.twig" %}

{% block title %}Inicio | Luxury Cars{% endblock %}

{% block description %}
Explorá vehículos, compará opciones y encontrá tu próximo auto.
{% endblock %}

{% block content %}

<section class="hero">
    <div class="container hero-content">

        <div class="hero-text">
            <span class="eyebrow">TU PRÓXIMO AUTO EMPIEZA ACÁ</span>

            <h1>
                Encontrá tu próximo
                <span>camino.</span>
            </h1>

            <p>
                Explorá opciones, compará vehículos y encontrá
                el que mejor se adapte a vos.
            </p>

            <div class="hero-actions">
                <a href="{{ path('app_auto_index') }}" class="btn btn-primary">
                    Explorar vehículos
                </a>

                {% if not is_granted('ROLE_ADMIN') %}
                    <a href="{{ path('app_contacto') }}" class="btn btn-outline">
                        Contactanos
                    </a>
                {% endif %}
            </div>
        </div>

        <div class="hero-card">
            <span class="hero-card-label">Luxury Cars</span>
            <div class="hero-card-symbol">
                <img src="{{ asset('assets/img/logo-home.png') }}"
                     alt="Luxury Cars"
                     class="hero-logo-img"
                     onerror="this.style.display='none'; this.nextElementSibling.style.display='inline';">
                <span class="hero-logo-fallback" style="display: none;">LC</span>
            </div>
            <p>Tu próximo destino está más cerca.</p>
        </div>

    </div>
</section>

<section class="features section">
    <div class="container">

        <div class="section-heading">
            <span class="eyebrow">UNA FORMA MÁS SIMPLE</span>
            <h2>Elegí con confianza.</h2>
            <p>Todo lo que necesitás para encontrar tu próximo vehículo.</p>
        </div>

        <div class="feature-grid">
            <article class="feature-card">
                <span class="feature-number">01</span>
                <h3>Explorá</h3>
                <p>Encontrá vehículos y filtrá según tus preferencias.</p>
            </article>

            <article class="feature-card">
                <span class="feature-number">02</span>
                <h3>Compará</h3>
                <p>Evaluá distintas opciones antes de tomar una decisión.</p>
            </article>

            <article class="feature-card">
                <span class="feature-number">03</span>
                <h3>Consultá</h3>
                <p>Contactá con atención al cliente y reservá una cita.</p>
            </article>
        </div>

    </div>
</section>

{% endblock %}
