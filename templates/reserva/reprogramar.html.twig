{% extends 'base.html.twig' %}

{% block title %}Reprogramar cita | Luxury Cars{% endblock %}

{% block content %}
<section class="section reserva-page">
    <div class="container reserva-narrow">
        <div class="panel-form">
            <span class="eyebrow">REPROGRAMAR CITA</span>
            <h1>Selecciona la nueva fecha y hora</h1>
            <p>El cambio debe realizarse con al menos 24 horas de anticipacion.</p>
            <form method="post" class="reserva-form">
                <input type="hidden" name="_token" value="{{ csrf_token('reprogramar_' ~ cita.id) }}">
                <label>Fecha
                    <input data-fecha-reprogramar type="date" name="fecha" min="{{ fechaMinima }}" value="{{ fecha|date('Y-m-d') }}" required>
                </label>
                <div class="time-grid" data-horarios data-url="{{ path('app_reservas_horarios') }}" data-cita="{{ cita.id }}">
                    {% for turno in horarios %}
                        <label class="time-option"><input type="radio" name="hora" value="{{ turno|date('H:i') }}" required><span>{{ turno|date('H:i') }} hs</span></label>
                    {% else %}
                        <div class="availability-error">No hay horarios disponibles para esta fecha.</div>
                    {% endfor %}
                </div>
                <div class="form-actions">
                    <a class="btn btn-outline" href="{{ path('app_reservas_detalle', {id: cita.id}) }}">Volver</a>
                    <button class="btn btn-primary" type="submit" {{ horarios is empty ? 'disabled' }}>Confirmar cambio</button>
                </div>
            </form>
        </div>
    </div>
</section>
{% endblock %}

{% block javascripts %}
<script>
const fecha = document.querySelector('[data-fecha-reprogramar]');
const contenedor = document.querySelector('[data-horarios]');
const boton = document.querySelector('button[type="submit"]');
async function actualizarHorarios() {
    const respuesta = await fetch(`${contenedor.dataset.url}?fecha=${fecha.value}&cita=${contenedor.dataset.cita}`, {headers: {'Accept': 'application/json'}});
    if (!respuesta.ok) return;
    const datos = await respuesta.json();
    contenedor.innerHTML = datos.horarios.length
        ? datos.horarios.map((turno) => `<label class="time-option"><input type="radio" name="hora" value="${turno.valor}" required><span>${turno.etiqueta}</span></label>`).join('')
        : '<div class="availability-error">No hay horarios disponibles para esta fecha.</div>';
    boton.disabled = datos.horarios.length === 0;
}
fecha.addEventListener('change', actualizarHorarios);
setInterval(actualizarHorarios, 15000);
</script>
{% endblock %}
