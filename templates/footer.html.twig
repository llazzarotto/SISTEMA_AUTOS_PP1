<footer class="site-footer">
    <div class="container footer-content">

        <div class="footer-brand">
            <a href="{{ path('app_home') }}" class="brand">
                <span class="brand-icon">
                    <img src="{{ asset('assets/img/logo.png') }}"
                         alt="Luxury Cars"
                         class="brand-logo-img"
                         onerror="this.style.display='none'; this.nextElementSibling.style.display='inline';">
                    <span class="brand-logo-fallback" style="display: none;">LC</span>
                </span>
                <span class="brand-name">LUXURY<span>CARS</span></span>
            </a>

            <p>
                Encontrá el auto indicado para tu próximo camino.
            </p>
        </div>

        <div class="footer-links">
            <a href="{{ path('app_auto_index') }}">Explorar autos</a>
            <a href="{{ path('app_financiacion') }}">Financiación</a>
            {% if not is_granted('ROLE_ADMIN') %}
                <a href="{{ path('app_contacto') }}">Contacto</a>
            {% endif %}
        </div>

        <div class="footer-bottom">
            <p>
                &copy; {{ "now"|date("Y") }} Luxury Cars.
                Todos los derechos reservados.
            </p>
        </div>

    </div>
</footer>
