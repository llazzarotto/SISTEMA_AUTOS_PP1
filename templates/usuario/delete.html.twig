{% extends 'cuentas/layout.html.twig' %}

{% block title %}Eliminar usuario | Luxury Cars{% endblock %}

{% block cuentas_content %}
    <div class="cuentas-heading">
        <div>
            <span class="eyebrow">GESTIÓN DE USUARIOS</span>
            <h1>Confirmar eliminación</h1>
        </div>
    </div>
    <div class="cuentas-card">
        <p>Vas a eliminar a <strong>{{ usuarioDetalle.nombre ?: usuarioDetalle.email }}</strong> ({{ usuarioDetalle.email }}).</p>
        <p>También se eliminarán sus citas, consultas y favoritos. Ingresá la razón y confirmá la eliminación.</p>
        {{ form_start(form, {attr: {class: 'cuentas-form'}}) }}
            {{ form_errors(form) }}
            {{ form_row(form.razon) }}
            {{ form_row(form.confirmar) }}
            <div class="cuentas-actions">
                <button type="submit" class="btn btn-primary">Eliminar usuario</button>
                <a href="{{ path('app_usuario_ver', {id: usuarioDetalle.id}) }}" class="btn btn-outline">Cancelar</a>
            </div>
        {{ form_end(form) }}
    </div>
{% endblock %}
