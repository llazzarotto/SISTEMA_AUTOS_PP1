{% extends 'cuentas/layout.html.twig' %}

{% block title %}Detalle del usuario | Luxury Cars{% endblock %}

{% block cuentas_content %}
    <div class="cuentas-heading">
        <div>
            <span class="eyebrow">GESTIÓN DE USUARIOS</span>
            <h1>Detalle del usuario</h1>
        </div>
    </div>

    <article class="cuentas-card">
        <dl class="cuentas-details">
            <dt>Nombre</dt><dd>{{ usuarioDetalle.nombre ?: 'Sin nombre' }}</dd>
            <dt>Email</dt><dd>{{ usuarioDetalle.email }}</dd>
            <dt>Rol</dt><dd>{{ usuarioDetalle.rol.nombre }}</dd>
            <dt>Fecha de nacimiento</dt><dd>{{ usuarioDetalle.fechaNacimiento ? usuarioDetalle.fechaNacimiento|date('d/m/Y') : 'Sin informar' }}</dd>
        </dl>
        <div class="cuentas-actions">
            {% if puedeGestionar %}
                <a href="{{ path('app_usuario_editar', {id: usuarioDetalle.id}) }}" class="btn btn-primary">Modificar usuario</a>
                <a href="{{ path('app_usuario_eliminar', {id: usuarioDetalle.id}) }}" class="btn btn-outline">Eliminar usuario</a>
            {% else %}
                <p>No podés modificar ni eliminar un usuario con un rol superior al tuyo.</p>
            {% endif %}
            <a href="{{ path('app_usuarios') }}" class="btn btn-outline">Volver al listado</a>
        </div>
    </article>
{% endblock %}
