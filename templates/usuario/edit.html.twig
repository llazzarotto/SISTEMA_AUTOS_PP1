{% extends 'cuentas/layout.html.twig' %}

{% block title %}Modificar usuario | Luxury Cars{% endblock %}

{% block cuentas_content %}
    <div class="cuentas-heading">
        <div>
            <span class="eyebrow">GESTIÓN DE USUARIOS</span>
            <h1>Modificar usuario</h1>
            <p>Actualizá los datos y confirmá los cambios.</p>
        </div>
    </div>
    <div class="cuentas-card">
        {% include 'usuario/_form.html.twig' with {boton: 'Confirmar cambios', cancelar: path('app_usuario_ver', {id: usuarioDetalle.id})} %}
    </div>
{% endblock %}
