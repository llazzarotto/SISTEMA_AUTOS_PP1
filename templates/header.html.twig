
<header class="site-header">
    <div class="container header-container">

        <a href="/" class="brand">
            <span class="brand-icon">LC</span>
            <span class="brand-name">LUXURY<span>CARS</span></span>
        </a>

        <nav class="main-navigation">
            <a href="/" class="nav-link">Inicio</a>
            <a href="/autos" class="nav-link">Explorar autos</a>
            <a href="/financiacion" class="nav-link">Financiación</a>
            <a href="/contacto" class="nav-link">Contacto</a>

            <div class="nav-actions">
                {% if app.user %}
                    <a href="/favoritos" class="nav-link">Favoritos</a>
                    {% if is_granted('ROLE_ADMIN') %}
                        <a href="{{ path('app_usuarios') }}" class="nav-link">Gestión de usuarios</a>
                    {% endif %}
                    <form action="{{ path('app_logout') }}" method="post">
                        <input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}">
                        <button type="submit" class="btn btn-outline">Cerrar sesión</button>
                    </form>
                {% else %}
                    <a href="{{ path('app_login') }}" class="nav-link">Ingresar</a>
                    <a href="{{ path('app_registro') }}" class="btn btn-primary">
                        Crear cuenta
                    </a>
                {% endif %}
            </div>
        </nav>

    </div>
</header>
