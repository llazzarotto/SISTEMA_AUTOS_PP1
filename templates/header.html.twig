<header class="site-header">
    <div class="container header-container">

        <a href="{{ path('app_home') }}" class="brand">
            <span class="brand-icon">
                <img src="{{ asset('assets/img/logo.png') }}"
                     alt="Luxury Cars"
                     class="brand-logo-img"
                     onerror="this.style.display='none'; this.nextElementSibling.style.display='inline';">
                <span class="brand-logo-fallback" style="display: none;">LC</span>
            </span>
            <span class="brand-name">LUXURY<span>CARS</span></span>
        </a>

        <nav class="main-navigation">
            <a href="{{ path('app_home') }}" class="nav-link">Inicio</a>
            <a href="{{ path('app_auto_index') }}" class="nav-link">Explorar autos</a>
            <a href="{{ path('app_financiacion') }}" class="nav-link">Financiación</a>
            {% if not is_granted('ROLE_ADMIN') %}
                <a href="{{ path('app_contacto') }}" class="nav-link">Contacto</a>
            {% endif %}

            {% set usuarioActual = usuario|default(app.user) %}
            {% if usuarioActual %}
                {% if is_granted('ROLE_ADMIN') %}
                    <a href="{{ path('inventario_index') }}" class="nav-link">Inventario</a>
                    <a href="{{ path('citas_admin') }}" class="nav-link">Citas</a>
                    <a href="{{ path('app_chat') }}" class="nav-link">Contestar mensajes</a>
                    <a href="{{ path('app_usuarios') }}" class="nav-link">Usuarios</a>
                {% else %}
                    <a href="{{ path('app_favorite_index') }}" class="nav-link">Favoritos</a>
                    <a href="{{ path('app_reservas_index') }}" class="nav-link">Mis citas</a>
                {% endif %}
            {% endif %}

            <div class="nav-actions">
                {% if usuarioActual %}
                    <form action="{{ path('app_logout') }}" method="post" class="logout-form">
                        <input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}">
                        <button type="submit" class="btn btn-outline">Cerrar sesión</button>
                    </form>
                {% else %}
                    <a href="{{ path('app_login') }}" class="nav-link">Ingresar</a>
                    <a href="{{ path('app_registro') }}" class="btn btn-primary">
                        Crear cuenta
                    </a>
                {% endif %}
            </div>
        </nav>

    </div>
</header>
